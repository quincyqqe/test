TELEGRAM_BOT_TOKEN=123456:telegram_bot_token_here
NVIDIA_NIM_API_KEY=nvapi_your_key_here

# Optional but recommended. Any long random string.
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Optional: comma-separated Telegram user IDs. Leave empty to allow everyone.
ALLOWED_TELEGRAM_USER_IDS=

# Optional NVIDIA settings.
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
